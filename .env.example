# ---------------------------------------------------------------------------
# Magnemite — copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Host port our Caddy publishes, in plain HTTP. Your own reverse proxy
# terminates TLS and forwards to it; nothing here listens on 80 or 443.
EDGE_PORT=8090
# Public base URL handed to agents at enrollment time. Artifact URLs are built
# from it, so it must be what the boxes can actually reach.
MAGNEMITE_PUBLIC_URL=https://magnemite.example.com

# --- Database --------------------------------------------------------------
# Which Prisma connector to use: "mysql", which also covers MariaDB -- Prisma
# has no separate mariadb provider -- or "postgresql". It has to match
# DATABASE_URL below, and changing it needs a rebuild: the Prisma Client is
# generated into the images. See packages/db/prisma.config.ts.
DB_PROVIDER=mysql

# The stack runs no database of its own. This points at one you already run,
# and it is resolved from inside the containers -- a host-published port like
# 127.0.0.1:5433 is the one address they cannot reach.
DATABASE_URL=mysql://magnemite:change-me-please@db.example.com:3306/magnemite

# --- Auth (Better Auth) ----------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=change-me-please
# The dashboard's own origin: checked by Better Auth, and the host the hub
# builds Discord alert links on. With the Caddy setup this is the same host as
# MAGNEMITE_PUBLIC_URL and compose fills it in for you; it only needs setting
# when the dashboard and the agents are on separate domains, as in
# deploy/compose.coolify.yml.
MAGNEMITE_DASHBOARD_URL=https://magnemite.example.com
# Base URL Better Auth builds callbacks from. Defaults to
# MAGNEMITE_DASHBOARD_URL (then Coolify's SERVICE_FQDN_WEB); a bare host with
# no scheme is accepted. Only set it when neither of those is right.
# BETTER_AUTH_URL=https://magnemite.example.com
# Seeded on `pnpm db:seed`. Re-running the seed resets this password, which is
# the way back in if you lose the admin login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# --- Hub -------------------------------------------------------------------
HUB_PORT=3001
# Interface the hub binds to.
HUB_HOST=0.0.0.0
# Where the dashboard reaches the hub's internal API. Inside compose this is
# the service name; outside docker it is http://localhost:3001.
HUB_URL=http://hub:3001
# Shared secret for web -> hub internal calls (SSE, dispatch nudges).
HUB_INTERNAL_SECRET=change-me-please
# Where cached .apkm artifacts live when running the hub outside docker.
# Inside compose this is always /data/artifacts, mounted into caddy.
ARTIFACT_DIR=../../data/artifacts
# Serve /files/* from the hub itself. Leave false in production: Caddy serves
# the artifacts off the shared volume, keeping Node out of the data path.
SERVE_ARTIFACTS=false

# --- Agent self-update -----------------------------------------------------
# The hub image ships the binaries it wants the fleet to run, so a box that
# reconnects on an older build is told to update itself. false pins the fleet
# and leaves updates to be driven by hand.
AGENT_AUTO_UPDATE=true
# Where the hub image keeps those binaries, next to the VERSION they were
# built from. Only worth changing outside docker.
AGENT_BIN_DIR=/app/agent-bin
# Max concurrent jobs, job stall timeout, heartbeat, the device offline timeout,
# health sampling and retention, and the monitoring graces and ceilings all live
# in Settings -> Tuning. How often a source is read is on the source
# (Settings -> Version sources); the auto-update cooldown and rollout policy are
# on the app (Settings -> Apps). None of them are read from here.

# --- Web push (optional) ---------------------------------------------------
# Notifications in the dashboard's own browsers, alongside Discord and ntfy.
# Generate the pair once:
#
#   npx web-push generate-vapid-keys
#
# It is deployment identity, not a tuning knob: a push service only accepts a
# message signed by the key it saw when the browser subscribed, so regenerating
# the pair silently unsubscribes every browser that already opted in. Leave
# both empty to keep web push unavailable -- Settings will say so rather than
# offering a button that cannot work.
#
# The hub needs both halves (it signs); the dashboard needs the public one (it
# hands it to the browser). Discord's webhook and the ntfy topic are not here:
# those are pasted into Settings -> Monitoring, which is also where each
# channel's minimum severity lives.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address a push service can complain to. Required by the VAPID spec
# as a mailto: or https: URL -- a JWT without one is rejected.
VAPID_SUBJECT=mailto:admin@example.com

# --- Rotom (optional) ------------------------------------------------------
# With this on, the hub asks Rotom once a minute what it thinks of each box.
# Read-only: it feeds the Scanner column and the "Rotom lost the box" monitoring
# rule. Installs do not touch Rotom.
ROTOM_ENABLED=false
# RotomNG's HTTP listener. /api is appended, so either form works.
ROTOM_URL=http://rotom:7072
# Matches `secret` under http_listener in the Rotom config.
ROTOM_SECRET=
# BasicAuth for a reverse proxy in front of Rotom. Separate from the secret
# above, not an alternative to it: set either, or both when the proxy gates a
# Rotom that also checks its own secret.
ROTOM_BASIC_USERNAME=
ROTOM_BASIC_PASSWORD=

# --- Redroid boxes on a machine (optional) ---------------------------------
# Only for the hand-written compose path, deploy/redroid.compose.yml. That file
# refuses to start without these two rather than bringing up containers that
# could never enroll, so a clean checkout needs them before `docker compose -f
# deploy/redroid.compose.yml up`. A machine the hub manages needs neither: it
# renders its own compose file from the instance rows, with its own token.
#
# The HUB's URL, never the dashboard's. It is what the agent inside each
# container dials out to, so it has to be an address the containers can reach.
REDROID_HUB_URL=http://hub.example.com:3001
# Settings -> Enrollment -> New token, and it is printed once. One token
# enrolls every container in the file; what tells the boxes apart is the
# ro.serialno in each one's own command block.
REDROID_ENROLL_TOKEN=
# The image `make redroid` tags, which tracks the redroid= line of VERSION. Not
# the agent version -- the agent updates itself over the wire, and moving this
# tag would cold-boot every container on the machine for nothing.
# REDROID_IMAGE=magnemite/redroid:1
# Per-container memory limit, and the reason a box reports its own memory
# rather than the machine's. Without it every box on the machine reports the
# host's total RAM as its own.
# REDROID_MEM_LIMIT=4g

# --- Logging ---------------------------------------------------------------
# Hub log level (pino): trace|debug|info|warn|error|fatal. Defaults to debug
# outside production, info in it.
# LOG_LEVEL=info
# Set to 1 to log every Prisma query. Noisy; development only.
# PRISMA_LOG=0
