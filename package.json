{
  "name": "magnemite",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./packages/*\" build && pnpm --filter \"./apps/*\" build",
    "db:generate": "pnpm --filter @magnemite/db generate",
    "db:migrate": "pnpm --filter @magnemite/db migrate",
    "db:deploy": "pnpm --filter @magnemite/db deploy",
    "db:push": "pnpm --filter @magnemite/db push",
    "db:studio": "pnpm --filter @magnemite/db studio",
    "db:seed": "pnpm --filter @magnemite/db seed",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "test": "pnpm --filter @magnemite/hub test"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
