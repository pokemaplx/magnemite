// Everything except the datasource block, which lives in
// datasource.postgresql.prisma or datasource.mysql.prisma and is picked by
// DB_PROVIDER. prisma.config.ts concatenates the two into schema.prisma
// (generated, gitignored) before every Prisma command — edit this file, not
// schema.prisma directly.

generator client {
  provider      = "prisma-client-js"
  // "native" covers local development on Windows/macOS; the musl target is
  // what the alpine-based hub and web images actually load.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum DeviceStatus {
  ONLINE
  OFFLINE
}

/// What sort of machine this agent runs on.
///
/// A box is what the fleet is for: hardware on a shelf, or a Redroid
/// container, which are the same thing to every message in the protocol. A
/// host is the Linux machine those containers run on -- same agent, same
/// socket, same metrics, same self-update, but it installs no APKs and takes
/// no rollouts.
///
/// A discriminator rather than a separate model, for the reason the Rotom
/// integration is twenty columns on this table rather than an entity of its
/// own: a host does everything `Device` already models, and a parallel entity
/// would mean a second token, socket, registry, offline sweep, enrollment
/// route, metric table, prune clock and self-update path, all to describe the
/// same behaviour. The cost is that every query meaning "a box" has to say so.
enum DeviceKind {
  BOX
  HOST
}

enum VersionSource {
  /// Discovered by polling a source feed. Which one is on `feedId`.
  MIRROR
  /// Uploaded by hand through the dashboard.
  MANUAL
}

enum VersionStatus {
  DISCOVERED // seen at the source, not downloaded yet
  CACHING // being downloaded onto the VPS
  READY // cached + hashed, installable
  FAILED
}

/// NORMAL runs both hooks. POST_ONLY skips the pre-install hook, for boxes
/// with nothing running yet. NONE skips both, for the deploy that lands before
/// the thing the hooks act on exists.
enum RolloutHookMode {
  NORMAL
  POST_ONLY
  NONE
}

enum RolloutMode {
  MANUAL
  AUTO
}

enum RolloutStatus {
  PENDING
  CANARY // canary jobs dispatched
  SOAKING // canary succeeded, waiting out soakMinutes
  RUNNING // full fleet dispatched
  PAUSED // canary failed or operator paused
  COMPLETED
  CANCELLED
}

/// Doubles as the current phase of a running job, which is what the dashboard
/// renders next to the progress bar.
enum JobState {
  QUEUED // waiting for a slot, or for the device to come online
  DISPATCHED // sent to the agent, not acknowledged yet
  DOWNLOADING
  EXTRACTING
  INSTALLING
  VERIFYING
  SUCCESS
  FAILED
  CANCELLED
  SKIPPED
}

enum InstallMode {
  IN_PLACE // pm install-create -r, app data preserved
  CLEAN // pm uninstall first, app data wiped
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

// ---------------------------------------------------------------------------
// Fleet
// ---------------------------------------------------------------------------

model Device {
  id     String @id @default(cuid())
  name   String
  /// ro.serialno, or a MAC-derived fallback. Identifies the box across
  /// re-enrollments and IP changes.
  ///
  /// On a host this is minted by the bootstrap into /etc/magnemite, and
  /// deliberately not read from /etc/machine-id: imaging a VPS from a snapshot
  /// clones that file, and two machines claiming one row would fight over the
  /// socket forever.
  serial String     @unique
  kind   DeviceKind @default(BOX)

  manufacturer   String?
  model          String?
  androidVersion String?
  sdkInt         Int?
  abi            String?
  agentVersion   String?

  /// What this box's agent says it can do, from its `hello` — a JSON array of
  /// strings, null on an agent old enough not to say. That is the point: a
  /// feature added to the protocol asks this rather than doing version
  /// arithmetic on `agentVersion`, which breaks the first time a build is
  /// backported. Json rather than String[] because a scalar list is Postgres
  /// only and this schema is generated for MariaDB too.
  capabilities Json?

  /// sha256 of the bearer token the agent presents. The plaintext token is
  /// shown once at enrollment and never stored.
  tokenHash String  @unique
  approved  Boolean @default(false)

  status        DeviceStatus @default(OFFLINE)
  lastSeenAt    DateTime?
  /// Address the socket came from. Behind the reverse proxy this is the same
  /// internal 10.x for every box, which is why the UI shows localIp instead.
  publicIp      String?
  /// The box's own LAN address, as reported by the agent. Null on agents old
  /// enough not to send it.
  localIp       String?
  freeBytes     BigInt?
  totalBytes    BigInt?
  uptimeSeconds Int?

  /// Run-queue averages and memory, straight off /proc on each heartbeat.
  /// Null on boxes running an agent old enough not to report them.
  loadAvg1          Float?
  loadAvg5          Float?
  loadAvg15         Float?
  cpuCount          Int?
  memTotalBytes     BigInt?
  memAvailableBytes BigInt?

  /// How busy this machine's own CPU is: 0-100 per core, so 250 means two and
  /// a half cores spent. The same convention as `processStatsSchema`, and the
  /// one that composes.
  ///
  /// The honest version of the load average. A container shares the host's
  /// /proc/loadavg and there is nothing to scope it to, but its own cgroup
  /// knows exactly how much CPU time it has spent. On hardware this is
  /// /proc/stat deltas and means the same thing, which is what lets a TV box
  /// and a container share one chart instead of needing two.
  cpuPercent        Float?

  /// Swap, which in practice only a host has and only a host needs: fifty
  /// workers in a container is where a VPS runs out of RAM, and swap is what
  /// stands between that and the OOM killer taking a container down mid-scan.
  swapTotalBytes    BigInt?
  swapFreeBytes     BigInt?
  /// Degrees Celsius off the box's thermal zones. Null on boxes whose ROM
  /// exposes no sensor at all, which is common on TV hardware — "cannot say"
  /// rather than "cold".
  cpuTempC          Float?
  batteryTempC      Float?
  /// When the agent last sent a full third-party package list, as opposed to
  /// just the tracked apps.
  packagesSyncedAt  DateTime?

  // --- Rotom (optional integration) ---------------------------------------
  /// The `origin` this box reports to Rotom.
  rotomOrigin      String?
  /// Rotom's own device id, the handle its action endpoints take.
  rotomDeviceId    String?
  /// Whether Rotom currently has a live socket to this box. This — not
  /// `pm` printing Success — is the real proof an update left it scanning.
  rotomConnected   Boolean   @default(false)
  rotomWorkerCount Int?
  rotomLastSeenAt  DateTime?
  /// Whether Rotom itself has the box enabled. A box someone disabled there on
  /// purpose is not a box Rotom lost, and monitoring must not confuse the two.
  rotomEnabled     Boolean   @default(true)
  /// Rotom's own verdict on whether it would hand this box work.
  rotomCanBeUsed   Boolean   @default(false)
  /// How many of `rotomWorkerCount` Rotom currently has allocated. Zero on a
  /// connected box is the case this integration exists for: online, registered,
  /// and being handed nothing.
  rotomWorkersInUse Int?
  /// Rotom's own verdict on whether the box is doing work right now.
  rotomInUse        Boolean @default(false)
  /// The scanner version Rotom sees. Health already counts these across the
  /// fleet; this is the same number per box.
  rotomVersion      String?
  /// Requests per second across this box's workers, over Rotom's five minute
  /// window. Null when no worker reports stats — Rotom only measures them in
  /// `requests` mode, or `proxy` mode with `inspect`, and a Rotom that does not
  /// measure is unknown rather than idle.
  rotomRequestRate  Float?
  /// Mean request duration in milliseconds over the same window, same null rule.
  rotomRequestMs    Float?
  /// How many workers answered with stats, which is what makes the two above
  /// readable: null there could be "no workers" or "this Rotom does not say".
  rotomStatWorkers  Int?

  // --- Monitoring ----------------------------------------------------------
  /// The package owning the focused activity, as of the last heartbeat that
  /// reported one. Null on a box that has never been asked, or that is on the
  /// launcher.
  foregroundPackage String?
  /// When a heartbeat last carried monitor fields at all. Null means the box
  /// runs an agent from before monitoring existed, which is why the rules that
  /// depend on the agent skip it rather than reading its silence as a fault.
  monitorReportedAt DateTime?

  notes   String?
  groupId String?
  group   DeviceGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  packages       DevicePackage[]
  jobs           Job[]
  agentUpdates   AgentUpdate[]
  logBundles     DeviceLogBundle[]
  metricSamples  DeviceMetricSample[]
  packageSamples DevicePackageMetricSample[]
  rotomSamples   RotomSample[]
  monitorStates  MonitorState[]
  monitorEvents  MonitorEvent[]

  /// Set only on a HOST, and only once its agent has enrolled.
  redroidHost     RedroidHost?
  /// Set on a BOX that is a Redroid container, once the instance row the hub
  /// minted its serial for has been claimed by an enrollment.
  redroidInstance RedroidInstance?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([groupId])
  /// Every fleet-wide query is "the boxes, by state". Leading on kind keeps
  /// the hosts out of it without a second scan.
  @@index([kind, status])
}

/// One attempt at swapping the agent binary on a box.
///
/// The row is written when the hub sends the update and closed when the box
/// comes back — on the new version, or with the error the agent reported. It
/// is what makes an agent update as auditable as an app update: without it a
/// failed self-update is invisible, because the only symptom is a box that
/// keeps reconnecting on the old version.
model AgentUpdate {
  id       String @id @default(cuid())
  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  /// Null when the box never reported a version before this update.
  fromVersion String?
  toVersion   String
  state       AgentUpdateState @default(SENT)
  /// What the agent said went wrong. Null unless state is FAILED.
  error       String?

  sentAt     DateTime  @default(now())
  finishedAt DateTime?

  @@index([deviceId, sentAt])
}

enum AgentUpdateState {
  SENT // told to update, not seen on the new version yet
  SUCCESS // reconnected running the new binary
  FAILED // the agent reported a download, checksum or swap failure
}

/// One "fetch me this box's logs" request.
///
/// The zip itself lives on the artifacts volume, not in here — this row is the
/// request, so a bundle that never arrived is visible as a failure rather than
/// as a download that silently does nothing.
model DeviceLogBundle {
  id       String @id @default(cuid())
  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  state DeviceLogBundleState @default(PENDING)
  /// Path inside ARTIFACT_DIR. Null until the upload lands.
  path      String?
  sizeBytes BigInt?
  /// Why it never arrived. Null unless state is FAILED.
  error     String?

  /// Who asked. Kept as an id rather than a relation: the bundle outliving the
  /// account that requested it is not a reason to lose the bundle.
  requestedById String?
  requestedAt   DateTime  @default(now())
  completedAt   DateTime?

  @@index([deviceId, requestedAt])
}

enum DeviceLogBundleState {
  PENDING // asked for, waiting on the box
  READY // uploaded and downloadable
  FAILED // the agent could not collect it, or never answered
}

/// One point on a box's health timeline.
///
/// The `Device` row only ever holds the latest reading, which answers "is this
/// box hot right now" but not "was it hot all night" — and the second question
/// is the one that explains a box that stopped scanning. This is that history:
/// one row per box per `metricsSampleSeconds`, pruned past
/// `metricsRetentionDays` (both in Settings, because how much history is worth
/// its disk is a per-fleet answer).
///
/// Deliberately *not* one row per heartbeat: boxes beat every 20 seconds and
/// nobody reads a chart at that resolution, so the hub samples on an interval
/// and drops the beats in between.
model DeviceMetricSample {
  /// An autoincrement, not a cuid: this is the highest-volume table in the
  /// schema and a 25-character random string per row is both bigger than the
  /// data it identifies and worse to index.
  id       Int    @id @default(autoincrement())
  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  at DateTime @default(now())

  loadAvg1          Float?
  loadAvg5          Float?
  loadAvg15         Float?
  /// Copied onto every sample rather than read off the Device: a load average
  /// only means something against the core count of the box *at the time*, and
  /// a re-flashed box can come back with a different one.
  cpuCount          Int?
  memTotalBytes     BigInt?
  memAvailableBytes BigInt?
  freeBytes         BigInt?
  totalBytes        BigInt?
  cpuTempC          Float?
  batteryTempC      Float?
  /// Share of a single core summed over the machine, as on `Device`. This is
  /// the series a container actually has -- its load average is the host's and
  /// says nothing about it.
  cpuPercent        Float?
  swapTotalBytes    BigInt?
  swapFreeBytes     BigInt?

  /// The chart's own query: one box, one time window.
  @@index([deviceId, at])
  /// The prune's query, which is fleet-wide and has no device to narrow by.
  @@index([at])
}

/// What one tracked app cost the box at one point in time.
///
/// Split from DeviceMetricSample rather than widened into it because the row
/// count differs by the number of tracked packages, and because an app that is
/// not running has no row at all — which is what makes "the scanner was dead
/// from 3am" visible as a gap rather than as a flat zero.
model DevicePackageMetricSample {
  id          Int    @id @default(autoincrement())
  deviceId    String
  device      Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  packageName String

  at DateTime @default(now())

  /// Share of a single core, so 200 means two cores pinned. See the protocol's
  /// processStatsSchema for why this is not normalised against the core count.
  cpuPercent   Float?
  rssBytes     BigInt?
  processCount Int?

  /// Building the package filter: which apps have any data in this window.
  @@index([deviceId, at])
  /// One box, one app, one window — the series behind a selected package.
  @@index([deviceId, packageName, at])
  @@index([at])
}

/// What Rotom said about one box at one point in time.
///
/// Its own table rather than columns on `DeviceMetricSample`, because the two
/// have different writers and different cadences: metric samples are cut from a
/// heartbeat, and this is cut from the Rotom sync. That difference is the whole
/// value of it — a box whose agent has died sends no heartbeat, and those are
/// exactly the minutes where what Rotom still sees is worth having.
///
/// A row per sync per matched box, written whether or not anything changed: a
/// flat line is a reading, and the gaps have to mean "nobody asked".
model RotomSample {
  /// An autoincrement for the same reason `DeviceMetricSample` uses one.
  id       Int    @id @default(autoincrement())
  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  at DateTime @default(now())

  connected Boolean
  enabled   Boolean
  canBeUsed Boolean
  inUse     Boolean

  workerCount  Int?
  workersInUse Int?
  /// Null where Rotom does not measure request rates. Never zero for that.
  requestRate  Float?
  /// Mean request duration over the same window, and null under the same rule
  /// — plus one of its own: no requests leaves nothing to average.
  requestMs    Float?

  /// The chart's own query: one box, one time window.
  @@index([deviceId, at])
  /// The prune's query, which is fleet-wide and has no device to narrow by.
  @@index([at])
}

/// Installed version of each package we track, refreshed on every heartbeat.
model DevicePackage {
  id          String  @id @default(cuid())
  deviceId    String
  device      Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  packageName String
  versionName String?
  versionCode BigInt?
  installed   Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@unique([deviceId, packageName])
  @@index([packageName, versionName])
}

model DeviceGroup {
  id   String @id @default(cuid())
  name String @unique

  /// Shell run as root on the device before the install session opens.
  /// Typically stops the scanner: `am force-stop <pkg>`.
  preInstallHook  String?
  /// Shell run as root after the install is verified. Typically restarts the
  /// scanner and re-applies the mod.
  postInstallHook String?

  /// Overrides the fleet-wide max concurrent jobs (Settings → Hub settings)
  /// for boxes in this group, e.g. to protect a site on a thin uplink.
  maxConcurrency Int?

  // --- MITM ----------------------------------------------------------------
  /// The MITM this group runs — Aegis, Atlas, GoCheats, whatever. Every box in
  /// the fleet reports its version (that is the MITM column), and every box in
  /// *this* group is configured with the JSON below.
  ///
  /// It lives here rather than in a fleet-wide list because the config does:
  /// two sites on two Rotom instances are two groups, and a config that could
  /// only be set once could not describe them both.
  mitmPackageName String?
  /// Column header. Falls back to the last dotted segment of the package name.
  mitmLabel       String?
  /// Where the file goes on the box. aconf's is
  /// `/data/local/tmp/<mitm>_config.json`; GoCheats reads
  /// `/data/local/tmp/config.json`.
  mitmConfigPath  String?
  /// The file's contents. `{{device.name}}` and friends are substituted per
  /// box before it is written — the same job aconf does with
  /// `sed 's,dummy,$origin,g'`.
  ///
  /// Text and not Json, for two reasons. It is a *template*, and a template is
  /// not always valid JSON: nothing parses `"workers": {{device.workers}}`
  /// until something has substituted it, and half-typed is a state a form
  /// field is in constantly. And a Json column normalises key order and
  /// whitespace, so an operator's file would not come back the way they wrote
  /// it. `@db.Text` because a bare String is VARCHAR(191) on MariaDB and an
  /// aegis config is longer than that.
  mitmConfig      String? @db.Text

  devices      Device[]
  monitorRules MonitorRule[]
  /// Machines whose new containers enroll into this group.
  redroidHosts RedroidHost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Redroid hosts
// ---------------------------------------------------------------------------

/// A Linux machine running Redroid containers.
///
/// Keyed on the Device its agent enrolled as, because a host with no agent is
/// a machine nobody can reach and there is nothing to record about it. The
/// machine's own readings -- load, memory, swap, disk, CPU -- live on that
/// Device like any other box's, which is the whole point of `DeviceKind`:
/// one metrics pipeline, one chart component, one prune.
///
/// What is left here is only what a box has no use for. Not a DeviceGroup
/// either: a group is a logical site -- its own comment says "two sites on two
/// Rotom instances are two groups" -- and a site can span three VPSes while
/// one VPS can hold two sites. This is the physical thing.
model RedroidHost {
  deviceId String @id
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  /// `docker compose -p` and the directory the rendered file is written to.
  /// Everything the hub renders lives under one project name, which is what
  /// makes --remove-orphans safe: it can only ever remove containers
  /// Magnemite put there.
  project String @default("magnemite-redroid")
  dir     String @default("/etc/magnemite/redroid")

  /// sha256 of the compose file this machine last converged, as the host read
  /// it back off its own disk -- so it says what is on the machine rather than
  /// what the hub meant, the same way a written MITM config does.
  ///
  /// Null until the first converge. Comparing a fresh render against this is
  /// how the hub decides a converge is needed at all, which is why the render
  /// has to be a pure function of the instance rows: anything conditional in
  /// it turns a reconnect into a container recreate.
  appliedSha256 String?
  appliedAt     DateTime?

  /// Whether this machine's existing containers have been imported as
  /// instance rows. Nothing is converged before that: a machine already
  /// running the hand-written compose file has containers holding real device
  /// identities, and an empty desired set would make every one of them an
  /// orphan for --remove-orphans to delete.
  adoptedAt DateTime?

  /// Last failure from a bootstrap or a converge, for the dashboard to show.
  /// Capped by the caller well under 64KB: @db.Text is TEXT on MariaDB, which
  /// is 65,535 bytes and errors rather than truncating, and docker's output on
  /// a cold image build is far larger than that.
  lastError   String?   @db.Text
  lastErrorAt DateTime?

  // --- defaults every instance on this machine inherits --------------------
  // Here as well as in Settings because a 32GB Ampere and an 8GB VPS want
  // different answers, and a box wants neither. Null falls back to the
  // `redroid.` settings group.
  /// What each container is capped at. This is the one field that decides
  /// whether a box reports its own RAM or the machine's, so the host reports
  /// the limit docker actually applied and the hub flags a mismatch.
  memLimitBytes BigInt?
  cpuset        String?
  /// androidboot.redroid_gpu_mode. "guest" is software rendering.
  gpuMode       String?
  /// Overrides the image tag every instance runs. Pinned to the Redroid base
  /// version, never to the agent's: `make redroid` tags from the agent line,
  /// so tying the rendered file to that would move the tag on every agent
  /// release and make compose recreate every container on the machine -- a
  /// full Android cold boot each, to deliver a binary the containers would
  /// have self-updated in seconds.
  image         String?

  /// The group a container on this machine enrolls into.
  ///
  /// Enrollment otherwise hard-codes `default`, and a box in the wrong group
  /// is handed the wrong MITM config by the first rollout that reaches it --
  /// with the sha256 read-back faithfully confirming the wrong file. Setting
  /// the site once per machine is what makes a new instance arrive already
  /// configured for where it actually is.
  ///
  /// Only a default: after enrolling, a box's group is its own and moves with
  /// the usual controls.
  defaultGroupId String?
  defaultGroup   DeviceGroup? @relation(fields: [defaultGroupId], references: [id], onDelete: SetNull)

  instances RedroidInstance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Declared rather than left to the foreign key: Postgres does not index one
  /// on its own, and `Device.groupId` next door sets the same precedent.
  @@index([defaultGroupId])
}

/// One Redroid container on one host.
///
/// A row exists before the container does, and before the Device it will
/// become: the hub mints the serial here, the renderer writes it into the
/// compose file, and the agent inside the container enrolls with it. That
/// ordering is what makes a container's identity survive being recreated.
model RedroidInstance {
  id     String      @id @default(cuid())
  hostId String
  host   RedroidHost @relation(fields: [hostId], references: [deviceId], onDelete: Cascade)

  /// Stable, sparse, and never renumbered. Removing instance 3 of ten leaves
  /// a gap and the next scale-up refills it; closing the gap would rewrite
  /// serials, and a changed serial is a new box with no history.
  index Int

  /// The serial the container reports, minted once and never changed.
  ///
  /// Derived from the host's immutable id rather than its name, so renaming a
  /// machine does not silently re-identify every box on it. Rendered as
  /// `ro.magnemite.serial`, which `magnemite-start.sh` reads -- the namespaced
  /// property, not `ro.serialno`, because it cannot collide with whatever the
  /// base image sets.
  serial String @unique

  /// The Device this container enrolled as, once it has. Null is the state
  /// worth reading: a container that is running and has never enrolled is the
  /// most common failure while setting a machine up, and without this field
  /// nothing can tell it apart from one that is not running at all.
  deviceId String? @unique
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  /// False is the desired state "gone". Kept as a row rather than deleted so
  /// re-adding the index brings the same box back; "forget" is what deletes.
  present Boolean @default(true)

  /// Workers this instance is configured for, substituted into the group's
  /// MITM config as {{device.workers}}. Magnemite owning this number is what
  /// makes a machine's capacity addable-up, and 50 is the per-container
  /// ceiling the scanners impose.
  workers Int?

  /// Per-instance overrides of the host's defaults. Null inherits.
  memLimitBytes BigInt?
  cpuset        String?
  image         String?

  // --- what the host last saw -----------------------------------------------
  /// docker's own state word: running, exited, restarting, created. Null
  /// before the first report. Current state, not history -- no process inside
  /// the container can see it, and it is not worth a time series.
  containerState String?
  /// Climbing restart counts are what distinguish a crash-looping instance
  /// from an idle one.
  restartCount   Int?
  /// The memory limit docker reports actually applied, against which
  /// `memLimitBytes` is checked. A silent miss here would have every box on
  /// the machine reporting the host's total RAM.
  appliedMemLimitBytes BigInt?
  reportedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The renderer's own query, and what keeps an index unique per machine.
  @@unique([hostId, index])
  @@index([hostId, present])
}

// ---------------------------------------------------------------------------
// Apps + versions
// ---------------------------------------------------------------------------

model AppTarget {
  id          String  @id @default(cuid())
  packageName String  @unique
  displayName String
  enabled     Boolean @default(true)

  /// Set on targets created by a manual upload rather than configured as a
  /// watched app. They have no source to poll and no auto-update policy: the
  /// Fleet and Versions pages are about the watched app and skip these, while
  /// the agent still reports their installed version like any other.
  manual Boolean @default(false)

  /// Only versions built for this ABI are tracked. Android TV boxes in this
  /// fleet are arm64; add a second target if that ever stops being true.
  arch String @default("arm64-v8a")

  // --- auto-update policy -------------------------------------------------
  autoUpdateEnabled Boolean @default(false)
  /// New versions are marked approved on discovery instead of waiting for a
  /// human to press approve.
  autoApprove       Boolean @default(false)
  /// Devices updated first; the rest wait for them to succeed.
  canaryCount       Int     @default(1)
  /// Minutes to wait after the canary succeeds before releasing the fleet.
  soakMinutes       Int     @default(30)
  maxConcurrency    Int?
  maxAttempts       Int     @default(3)
  /// Seconds to hold a failed job before its next attempt. Doubles per
  /// attempt. Copied onto the rollouts this target creates.
  retryBackoffSeconds Int   @default(60)
  /// Minutes since this app's last automatic rollout finished before another
  /// may start. 0 ships a new build as soon as it is discovered. Per target
  /// rather than fleet-wide: a scanner people watch all day and a launcher
  /// nobody notices do not want the same restraint.
  updateCooldownMinutes Int @default(0)
  /// "HH:MM" local time. When both are set, auto rollouts only dispatch
  /// inside this window.
  windowStart       String?
  windowEnd         String?

  versions AppVersion[]

  /// Which feeds are polled for this package. A target with none selected is
  /// never polled — the feeds are indexes of many apps, so "all of them" is a
  /// choice worth making per target rather than a default that quietly picks
  /// up whatever is added later.
  sources AppTargetSource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A place that publishes an index of installable builds.
///
/// Every feed speaks the same shape — the flat JSON array the UnownHash mirror
/// serves — so adding one is a URL in Settings rather than code. Entries may
/// carry an absolute `url`, in which case `baseUrl` is not needed.
model SourceFeed {
  id       String  @id @default(cuid())
  name     String  @unique
  /// The index.json to poll.
  indexUrl String
  /// Prefix for entries whose `filename` is not an absolute URL. Null when the
  /// index publishes `url` on every entry.
  baseUrl  String?
  enabled  Boolean @default(true)
  /// Lowest wins when two feeds publish the same version of the same build.
  /// The version is stored once; this decides whose URL is downloaded.
  priority Int     @default(100)
  /// Minutes between reads of this index. Per feed rather than fleet-wide,
  /// because the feeds are somebody else's servers: a mirror that publishes
  /// hourly and one that publishes on release do not want the same cadence,
  /// and the polite interval is the feed's to decide, not the fleet's.
  pollMinutes Int   @default(15)

  versions AppVersion[]
  targets  AppTargetSource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Which feeds a target is polled from.
///
/// An explicit join rather than an implicit many-to-many so the pairing can
/// grow a column later — a per-target override of the feed's priority is the
/// obvious one — without a migration that rewrites the table Prisma owns.
model AppTargetSource {
  appTargetId String
  appTarget   AppTarget  @relation(fields: [appTargetId], references: [id], onDelete: Cascade)
  feedId      String
  feed        SourceFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([appTargetId, feedId])
  @@index([feedId])
}

model AppVersion {
  id          String    @id @default(cuid())
  appTargetId String
  appTarget   AppTarget @relation(fields: [appTargetId], references: [id], onDelete: Cascade)

  /// Marketing version, e.g. "0.425.1".
  version     String
  /// Play build code from the GitHub tag, e.g. "2026081202".
  buildCode   String?
  /// Android versionCode, filled in once a device reports it.
  versionCode BigInt?

  source    VersionSource
  /// Which feed listed it. Null for manual uploads.
  feedId    String?
  feed      SourceFeed?   @relation(fields: [feedId], references: [id], onDelete: SetNull)
  arch      String        @default("arm64-v8a")
  remoteUrl String
  filename  String
  sizeBytes BigInt

  /// From the feed index, when it publishes one. Feeds that publish no hash
  /// leave this null and the download is checked by size.
  md5    String?
  /// Computed by the hub after caching. This is what agents verify against.
  sha256 String?

  /// Path inside ARTIFACT_DIR, served by Caddy as /files/<basename>.
  artifactPath  String?
  status        VersionStatus @default(DISCOVERED)
  cacheProgress Int           @default(0)
  error         String?

  approved     Boolean   @default(false)
  publishedAt  DateTime?
  discoveredAt DateTime  @default(now())

  rollouts Rollout[]

  /// One row per build, whichever feed happened to list it first. Two feeds
  /// mirroring the same release are the same thing to everyone downstream —
  /// the fleet, the rollouts, the Versions page — so it is stored once.
  @@unique([appTargetId, version, arch])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Rollouts + jobs
// ---------------------------------------------------------------------------

model Rollout {
  id           String     @id @default(cuid())
  appVersionId String
  appVersion   AppVersion @relation(fields: [appVersionId], references: [id], onDelete: Restrict)

  mode   RolloutMode   @default(MANUAL)
  status RolloutStatus @default(PENDING)

  /// Uninstall before installing on every device, wiping app data, instead of
  /// only falling back to it when an in-place upgrade is rejected.
  forceClean     Boolean @default(false)
  canaryCount    Int     @default(0)
  soakMinutes    Int     @default(0)
  maxConcurrency Int?
  maxAttempts    Int     @default(3)
  /// Seconds to hold a failed job before it may be dispatched again, doubling
  /// with each attempt and capped at retryBackoffCeilingSeconds.
  ///
  /// Zero restores the old behaviour of retrying on the very next scheduler
  /// tick, which is wrong for the failure that motivated this: an install
  /// heavy enough to take system_server down leaves the box rebuilding its
  /// Android for the best part of a minute, and a retry that arrives inside
  /// that window fails instantly on a box that is about to be fine.
  retryBackoffSeconds Int @default(60)

  /// Hooks for this rollout only, overriding the ones on the device's group.
  /// A manual deploy of some other app needs to stop and start that app, not
  /// whatever the group stops for the watched one.
  preInstallHook  String?
  postInstallHook String?

  /// Which of the resolved hooks this rollout is allowed to run.
  ///
  /// Null on `preInstallHook` already means "fall back to the group", so there
  /// was no way to say "run neither" — which is what a first deploy onto bare
  /// boxes needs. Setting up a fleet is two deploys: the watched app, where
  /// there is no scanner to stop *or* start, and then the MITM, where there is
  /// nothing to stop but the hook that starts it finally has something to
  /// start.
  hookMode RolloutHookMode @default(NORMAL)

  /// Whether this rollout may write the group's MITM config.
  ///
  /// True is the point of the feature: a deploy of a group's own MITM carries
  /// that group's config, and there is no other way for an edited one to reach
  /// the fleet. False is for the deploy that must not touch what is already on
  /// the boxes — reinstalling the scanner after a crash, rolling a build back,
  /// pushing a hotfix while the config on disk is one somebody edited by hand.
  writeConfig Boolean @default(true)

  note        String?
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  canaryPassedAt DateTime?
  finishedAt     DateTime?

  jobs Job[]

  @@index([status])
}

model Job {
  id        String  @id @default(cuid())
  rolloutId String
  rollout   Rollout @relation(fields: [rolloutId], references: [id], onDelete: Cascade)
  deviceId  String
  device    Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  state    JobState @default(QUEUED)
  /// 0-100 within the current state. Download progress is the slow one.
  progress Int      @default(0)
  isCanary Boolean  @default(false)

  attempt   Int     @default(0)
  lastError String?

  installMode InstallMode?
  /// True when the install had to fall back to uninstall, or forceClean was
  /// set. Surfaced in the UI because it means the box lost its app data.
  dataWiped   Boolean      @default(false)

  fromVersion String?
  toVersion   String

  queuedAt     DateTime  @default(now())
  /// Set when a failed attempt is re-queued: the scheduler passes the job over
  /// until this has gone by. Null means eligible now, which is every job that
  /// has not failed yet.
  nextAttemptAt DateTime?
  dispatchedAt DateTime?
  startedAt    DateTime?
  /// Last progress message from the agent, used to detect stalled jobs.
  heartbeatAt  DateTime?
  finishedAt   DateTime?

  events JobEvent[]

  @@unique([rolloutId, deviceId])
  @@index([state])
  @@index([state, nextAttemptAt])
  @@index([deviceId, state])
}

model JobEvent {
  id      String    @id @default(cuid())
  jobId   String
  job     Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  ts      DateTime  @default(now())
  level   LogLevel  @default(INFO)
  phase   JobState?
  message String

  @@index([jobId, ts])
}

// ---------------------------------------------------------------------------
// Access
// ---------------------------------------------------------------------------

model EnrollmentToken {
  id        String @id @default(cuid())
  label     String
  /// sha256 of the token. The plaintext is shown once, when it is created.
  tokenHash String @unique
  /// First 8 chars of the plaintext, so the UI can tell tokens apart.
  prefix    String

  /// What this token may enrol. A token minted for boxes cannot bring up a
  /// host and vice versa, because the two are handed out in completely
  /// different places: a box token is flashed into a module zip by a person, a
  /// host token is minted per machine and written into that machine's compose
  /// file.
  kind DeviceKind @default(BOX)

  /// Devices enrolling with this token skip manual approval.
  ///
  /// Forced true for HOST, and the form offers no switch for it: `/internal/authz`
  /// refuses an unapproved device, so a host that enrolled unapproved would
  /// get a bare 401 from the edge on its first self-update, with nothing
  /// anywhere to say why.
  autoApprove Boolean   @default(true)
  maxUses     Int?
  uses        Int       @default(0)
  revoked     Boolean   @default(false)
  expiresAt   DateTime?

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Better Auth
//
// These four models are the shape Better Auth's Prisma adapter expects; the
// only addition is `role`, declared as an additional field in the auth config.
// Passwords live on Account (providerId "credential"), hashed with bcrypt so
// the database seed can create the first admin without pulling Better Auth
// into the db package.
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  name          String   @default("")
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          UserRole @default(VIEWER)

  sessions Session[]
  accounts Account[]
  rollouts Rollout[]
  pushSubscriptions PushSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id         String @id @default(cuid())
  /// Namespaces the identity so an OAuth provider id can never collide with a
  /// local one. Credential accounts use "local:credential"
  /// (`CREDENTIAL_ISSUER` in @magnemite/db) — sign-in looks the account up by
  /// this, so a row without it simply will not authenticate.
  issuer     String
  accountId  String
  providerId String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// bcrypt hash for credential accounts; null for OAuth providers.
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userEmail  String?
  action     String
  targetType String?
  targetId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Fleet-wide key/value settings that are editable from the dashboard.
/// Anything that belongs in infrastructure config lives in env instead.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Monitoring
// ---------------------------------------------------------------------------

/// What a rule watches for.
///
/// The signals split into two kinds, and the difference decides what happens
/// when the answer is missing. The hub can see AGENT_OFFLINE and
/// ROTOM_DISCONNECTED for itself; the rest are only knowable on the box, and
/// an agent old enough not to report them says nothing at all. Silence there
/// is unknown, never a fault.
enum MonitorSignal {
  AGENT_OFFLINE // the socket has been gone longer than the alert delay
  SERVICE_DOWN // a tracked package has no processes on the box
  APP_NOT_FOREGROUND // something else owns the screen
  APP_ANR // the package is sitting on an ANR dialog
  HEALTH_CHECK_FAILED // a configured probe came back bad
  LOOP_STALLED // the scanner is alive but has stopped doing anything
  ROTOM_DISCONNECTED // Rotom stopped seeing the box, or has no workers on it
  ROTOM_NOT_SCANNING // Rotom has the box and no worker is allocated on it
  ROTOM_IDLE // a worker is allocated and making no requests at all

  // --- hosts ---------------------------------------------------------------
  // Each one is its own value rather than a HEALTH_CHECK_FAILED rule with a
  // shell probe, which is the cheaper-looking design and does not work:
  // `rulesFor` dedupes on signal + packageName and keeps one winner per key,
  // so three host probe rules would collapse into one and the other two would
  // never run -- no error, no probe, nothing in the log.
  HOST_DOCKER_DOWN // the agent is up and the docker daemon is not
  HOST_MEMORY_LOW // free memory or swap under the rule's floor
  HOST_DISK_LOW // the filesystem docker keeps its images and volumes on
  REDROID_INSTANCE_DOWN // a container that should be running is not
}

/// What a rule does about it. Everything except REBOOT and the ROTOM_* three is
/// a shell command with an editable default — the catalog exists so an alert can
/// say "cleared the cache and restarted" instead of quoting a command line.
///
/// REBOOT rides the agent's socket and the ROTOM_* three ride Rotom's own, which
/// is the whole reason both kinds of reboot exist: they are the only remediation
/// left when the other side is the one that died.
enum MonitorAction {
  NOTIFY_ONLY
  RESTART_APP
  KILL_APP
  CLEAR_CACHE_RESTART
  SEND_KEYEVENT
  START_SERVICE
  SHELL
  REBOOT
  ROTOM_RESTART
  ROTOM_DISCONNECT
  ROTOM_REBOOT
  /// Restart one Redroid container, from the host that runs it. The host-side
  /// counterpart of RESTART_APP: it is the smallest thing that fixes a wedged
  /// instance, and REBOOT is deliberately not extended to mean "reboot the
  /// VPS" -- that takes every box on the machine down at once.
  RESTART_INSTANCE
}

enum MonitorLevel {
  INFO
  WARN
  CRITICAL
}

/// One thing worth watching, and what to do about it.
///
/// Rules are rows rather than code because every MITM setup answers to
/// different service names and writes differently formatted logs. The same
/// reason drives the group override: a fleet with two sites running different
/// scanners needs two answers to the same question.
model MonitorRule {
  id      String  @id @default(cuid())
  name    String
  /// Seeded rules arrive disabled. Upgrading a fleet must never silently start
  /// rebooting it.
  enabled Boolean @default(false)

  /// Null is fleet-wide. A group-scoped rule for the same signal and package
  /// replaces the fleet-wide one for that group's boxes — it does not stack,
  /// or a box would be restarted twice for one fault.
  groupId String?
  group   DeviceGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  /// Which kind of machine this rule is about. A box rule evaluated against a
  /// VPS would read a scanner's absence as a fault on a machine that never ran
  /// one; a host rule against a box would do the mirror image.
  ///
  /// This is also what lets AGENT_OFFLINE cover a machine going silent with no
  /// signal of its own -- it already means exactly the right thing on a
  /// `Device`, whichever kind it is.
  appliesTo DeviceKind @default(BOX)

  signal MonitorSignal
  /// The package the signal and its actions are about. Null for the signals
  /// that are about the box itself.
  packageName String?
  /// Per-signal knobs — the probe command, the patterns, the thresholds. The
  /// shape follows `signal`, and the probe half is what the box is sent.
  config      Json

  /// Consecutive bad samples before the ladder starts. 1 acts immediately.
  threshold       Int @default(1)
  /// Seconds after an action before this rule may act on that box again.
  cooldownSeconds Int @default(300)

  /// Act only inside this window, "HH:MM". Alerts still go out outside it:
  /// quiet hours are about not rebooting a box at 3am, not about hiding that
  /// it needs it.
  windowStart String?
  windowEnd   String?

  /// The severity this rule's alerts carry. Not a gate any more -- it decides
  /// how an alert *looks*: the Discord embed colour, ntfy's priority dial, and
  /// whether a browser notification stays on screen until it is dealt with.
  /// It stopped being a filter when rules gained their own channel list: two
  /// reasons an alert might not arrive, one of them invisible from the rule,
  /// is the silent hour this file exists to avoid.
  notifyLevel    MonitorLevel @default(WARN)
  /// Which channels this rule announces to, as a JSON array of ids --
  /// `["discord", "ntfy", "webPush"]`. An empty array is the old "announce
  /// off": a signal that fires often enough to be noise is still worth acting
  /// on quietly.
  ///
  /// JSON rather than a scalar list because Prisma's `String[]` is Postgres
  /// only and this schema has to generate for MariaDB too, and rather than
  /// three booleans because a fourth channel should not need a migration.
  /// Anything unreadable in here is read as *every* channel, never as none:
  /// of the two ways to be wrong, shouting is the recoverable one.
  ///
  /// No `@default`, deliberately. Prisma silently drops a Json default on
  /// MySQL -- the column comes out `JSON NOT NULL` with nothing behind it --
  /// so a default here would work on Postgres and fail every create on
  /// MariaDB. Both creates pass it explicitly instead.
  notifyChannels Json
  /// Whether the all-clear is announced too, once a fault this rule alerted
  /// about has cleared. Off by default: it doubles the traffic a flapping box
  /// makes, and only some faults are worth being told have ended.
  notifyRecovery Boolean      @default(false)

  position  Int            @default(0)
  steps     MonitorStep[]
  states    MonitorState[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([enabled, signal])
  @@index([groupId])
}

/// One rung of the escalation ladder: soft first, hard second.
model MonitorStep {
  id     String      @id @default(cuid())
  ruleId String
  rule   MonitorRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  /// Which consecutive failure this answers — 1 is the first, 2 the second.
  /// "Offline once, restart it; offline twice, reboot the box."
  atFailure Int
  action    MonitorAction
  /// The shell this action runs, with `{pkg}` substituted. Null uses the
  /// catalog default, so a rule reads as an action rather than a command line.
  command   String?

  @@unique([ruleId, atFailure])
}

/// Per-box, per-rule counter.
///
/// The only mutable state the engine keeps, and it is in the database rather
/// than in memory on purpose: the hub restarts on every deploy, and a ladder
/// that reset to zero each time would keep softly restarting a box that has
/// already proved a restart does not fix it.
model MonitorState {
  deviceId String
  ruleId   String
  device   Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  rule     MonitorRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  failures      Int       @default(0)
  firstFailedAt DateTime?
  lastActionAt  DateTime?
  /// The rung last fired, so an escalation never repeats a step it has
  /// already spent.
  lastStepFired Int?

  @@id([deviceId, ruleId])
  @@index([ruleId])
}

/// What the engine actually did, so "why did this box reboot at 3am" has an
/// answer. Pruned on the same clock as the metric samples.
model MonitorEvent {
  id       String @id @default(cuid())
  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  /// Null once the rule that caused it has been deleted; the history stays.
  ruleId   String?

  signal   MonitorSignal
  level    MonitorLevel
  message  String
  action   MonitorAction?
  /// Null for an event that took no action — a recovery, or a notify-only rule.
  actionOk Boolean?
  /// A probe's detail line, or a command's output. The one field here that
  /// needs more than the 191 characters a String gets on MySQL: the agent caps
  /// a detail at 512 bytes, and a truncated explanation is worse than none.
  detail   String?        @db.Text
  /// Whether this went to Discord, so a silent hour is explicable.
  notified Boolean        @default(false)
  /// The all-clear rather than a fault. Kept as a column rather than read off
  /// the level or the message because the alert dedupe window has to ignore
  /// these in both directions: a recovery must not be swallowed by the fault
  /// it ends, and must not swallow the next fault either.
  recovery Boolean        @default(false)

  at DateTime @default(now())

  @@index([deviceId, at])
  @@index([at])
}

/// A browser that asked to be told about faults, as the Web Push spec stores
/// one: an endpoint on somebody else's push service, plus the two keys that
/// let us encrypt to it. There is no way to ask a push service what it still
/// holds, so the only cleanup that works is deleting a row the moment it
/// answers 404 or 410.
///
/// Keyed by a hash of the endpoint rather than the endpoint itself. It has to
/// be unique — re-subscribing the same browser must update the row, not add a
/// second one — and endpoints run past the 191 characters a String gets on
/// MariaDB, which is exactly the length MySQL will not index. A sha256 is 64
/// and indexes identically on both.
model PushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// sha256 of `endpoint`, hex. The lookup key; never sent anywhere.
  endpointHash String @unique
  endpoint     String @db.Text
  /// The subscription's public key and auth secret, base64url, straight from
  /// `PushSubscription.toJSON()` in the browser.
  p256dh       String @db.Text
  auth         String

  /// What the browser called itself when it subscribed, so somebody with four
  /// of these can tell which one to revoke. Cosmetic.
  label String @default("")

  /// When this endpoint last accepted a push. Null until the first one goes
  /// out, which is also how a subscription that never worked is spotted.
  lastSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
