# Magnemite's own edge, for the docker-compose deployment.
#
# TLS is not ours to terminate: whatever reverse proxy already fronts your
# server does that and forwards plain HTTP here, so auto-HTTPS is off and the
# site address carries no domain — this listens on :8090 and serves whatever
# is routed to it. Point your proxy's virtual host at the published EDGE_PORT.
#
# It exists because a reverse proxy is not a file server and cannot mount our
# artifacts volume — so without this the ~170 MB bundles would go out through
# Node (SERVE_ARTIFACTS=true). Here they stream straight off the shared volume,
# with Range handled natively, and Node stays out of the data path.
{
	auto_https off
	admin off
}

:8090 {
	log {
		output stdout
		format console
	}

	# --- Artifact downloads -------------------------------------------------
	# Up to N devices pulling a ~170 MB .apkm. Served straight off the shared
	# volume so Node never sits in the data path: Caddy handles Range requests
	# natively, which is what makes an interrupted download resumable.
	handle_path /files/* {
		# Every request carries the device's bearer token; the hub says yes or no.
		forward_auth hub:{$HUB_PORT} {
			uri /internal/authz
			copy_headers X-Device-Id
		}
		root * /srv/artifacts
		# No `encode` here: .apkm is a zip, compressing it again just burns CPU.
		file_server
	}

	# --- Device WebSocket ---------------------------------------------------
	handle /ws/device {
		reverse_proxy hub:{$HUB_PORT}
	}

	# --- Agent enrollment (no session yet, so it bypasses the dashboard) -----
	handle /api/enroll {
		reverse_proxy hub:{$HUB_PORT}
	}

	# --- Log bundles the boxes upload ---------------------------------------
	# A zip of logcat, pushed by the box when the dashboard asks for it. The
	# hub authenticates it with the device's own token, same as a download.
	handle /api/logs/* {
		reverse_proxy hub:{$HUB_PORT}
	}

	# --- Screenshots the boxes upload ---------------------------------------
	# A PNG off `screencap`, pushed the same way and for the same reason a log
	# bundle is: the socket caps a frame at 1 MB and a 1080p screen is
	# regularly more than that. Authenticated by the device's own token.
	handle /api/screenshots/* {
		reverse_proxy hub:{$HUB_PORT}
	}

	# --- Live job/device updates for the dashboard --------------------------
	# The *dashboard*, not the hub. /api/events is a Next route that checks the
	# session cookie and then proxies the hub's /internal/events with the
	# internal secret -- the hub has no /api/events of its own, so sending this
	# to it 404s and the dashboard silently stops live-updating.
	#
	# It still needs a block of its own rather than falling through to the
	# catch-all below, because that one has `encode` on it and compressing an
	# SSE stream buffers it -- which is the same symptom by a different route.
	handle /api/events* {
		reverse_proxy web:3000 {
			# SSE: never buffer, never time out an idle stream.
			flush_interval -1
		}
	}

	# --- Dashboard ----------------------------------------------------------
	handle {
		encode zstd gzip
		reverse_proxy web:3000
	}
}
